# Render PostgreSQL i produktion: lägg ?sslmode=require sist i adressen.
# Neon via Vercel: se docs/VERCEL.md. Sätt även MIGRATE_DATABASE_URL (direkt adress utan pooler) för migreringar vid bygge.
# MIGRATE_DATABASE_URL=""
DATABASE_URL="postgresql://hem:hem@localhost:5432/hemskarm"
# Minst 32 tecken. Generera: openssl rand -base64 32. Används även för att kryptera tjänstetokens.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Extra adresser som får logga in (t.ex. datorns adress på hemmets nätverk): AUTH_TRUSTED_ORIGINS="http://192.168.1.20:3000"
# AUTH_RATE_LIMIT_SCALE=1  # endast för automatiska tester

# Sonos och Spotify (etapp 2). Skapa appar enligt docs/DRIFT.md och registrera redirect-URI:erna där.
# Redirect-URI: ${BETTER_AUTH_URL}/api/connect/sonos/callback och /api/connect/spotify/callback
# Spotify kräver https eller http://127.0.0.1:PORT (aldrig localhost): kör lokalt med BETTER_AUTH_URL="http://127.0.0.1:3000".
SONOS_CLIENT_ID=""
SONOS_CLIENT_SECRET=""
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# Škoda (docs/SKODA.md). I Vercel: SKODA_USERNAME, SKODA_PASSWORD och SKODA_BRIDGE_TOKEN i samma projekt.
# SKODA_BRIDGE_URL behövs bara om bryggan körs på annan adress (lokalt: http://127.0.0.1:8080 med `python -m skoda_bridge`).
SKODA_BRIDGE_TOKEN=""
SKODA_BRIDGE_URL=""
